#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Running lint before push..."
npm run lint
RESULT=$?

echo "🧪 Running tests before push..."
npm run test
RESULT2=$?

if [ $RESULT -ne 0 ] || [ $RESULT2 -ne 0 ]; then
  echo "❌ Push blocked: fix lint/test errors first!"
  exit 1
fi

echo "✅ All checks passed, push allowed."
